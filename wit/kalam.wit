package kalam:plugin;

interface types {
    /// A paginated page of search results.
    record search-page {
        results: list<remote-book-card>,
        has-more: bool,
    }

    /// Metadata for a remote book discovered via search or browse.
    record remote-book-card {
        remote-id: string,
        title: string,
        author: string,
        cover-url: option<string>,
    }

    /// Detailed metadata for a remote book.
    record remote-book-details {
        remote-id: string,
        title: string,
        author: string,
        description: string,
        cover-url: option<string>,
        tags: list<string>,
        status: string,
    }

    /// Metadata for a remote chapter.
    record remote-chapter {
        chapter-id: string,
        title: string,
        number: float32,
        volume: option<float32>,
        url: option<string>,
    }

    /// What a chapter contains.
    variant chapter-content {
        images(list<string>),
        html(string),
    }

    /// Filter types for dynamic generic UI
    variant filter-type {
        text(string),
        checkbox,
        select(list<tuple<string, string>>),
        sort(list<tuple<string, string>>),
    }

    /// Dynamic filter metadata
    record filter-definition {
        id: string,
        name: string,
        filter-type: filter-type,
        default-value: string,
    }
}

/// The Host environment HTTP API
interface host {
    /// Fetch raw bytes from a URL.
    fetch: func(url: string, headers: list<tuple<string, string>>) -> result<list<u8>, string>;
}

/// The Scraper Plugin Interface
interface scraper {
    use types.{
        search-page, remote-book-details, remote-chapter, 
        chapter-content, filter-definition
    };

    /// Internal unique ID of this source (e.g., "mangadex").
    id: func() -> string;
    
    /// Human-readable name of this source.
    name: func() -> string;
    
    /// Base URL for this source, if applicable.
    base-url: func() -> string;

    /// Declare available dynamic search filters.
    get-filter-definitions: func() -> list<filter-definition>;

    /// Search for books.
    search: func(query: string, page: u32, filters: list<tuple<string, string>>) -> result<search-page, string>;

    /// Fetch detailed metadata for a book.
    get-details: func(remote-id: string) -> result<remote-book-details, string>;

    /// Fetch the list of chapters for a book.
    get-chapters: func(remote-id: string) -> result<list<remote-chapter>, string>;

    /// Fetch the content of a specific chapter.
    get-chapter-content: func(chapter-id: string) -> result<chapter-content, string>;
}

/// The Metadata Provider Interface (for later)
interface metadata-provider {
    use types.{remote-book-details};

    id: func() -> string;
    name: func() -> string;
    search: func(title: string, author: string) -> result<list<remote-book-details>, string>;
}

world plugin {
    import host;
    export scraper;
}
